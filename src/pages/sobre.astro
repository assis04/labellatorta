---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import { institutionalPageSchema } from '../components/pages/page-schema';
import { business, links } from '../data/business';
import { doces, salgadas, tortas } from '../data/menu';
import { href } from '../lib/links';
import fotoPreparo from '../assets/fotos/preparo-creme-de-queijo.jpg';
import seloGuru from '../assets/fotos/selo-restaurant-guru-2026.png';

const award = `${business.award.name} ${business.award.year}`;
const title = 'Sobre nós: tortaria no Parque São Jorge';
const description = `Tortaria artesanal no Parque São Jorge: massa bem fininha, duas camadas de recheio e creme de queijo da casa. Recomendada pelo Restaurant Guru em ${business.award.year}.`;
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Sobre nós', path: '/sobre/' },
];
const schema = [
  institutionalPageSchema(
    'AboutPage',
    { path: '/sobre/', name: `Sobre a ${business.name}`, description },
    Astro.site,
  ),
];

const traits: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'slice',
    title: 'Massa bem fininha',
    text: 'Só na base e nas bordas. Ela segura a fatia e deixa o recheio aparecer.',
  },
  {
    icon: 'layers',
    title: 'Duas camadas de recheio',
    text: 'Nas tortas salgadas, são duas camadas generosas de recheio por cima da massa.',
  },
  {
    icon: 'cheese',
    title: 'Creme de queijo da casa',
    text: 'Uma receita própria, que cobre o recheio das salgadas e gratina no forno.',
  },
  {
    icon: 'leaf',
    title: 'Ingredientes selecionados',
    text: 'Como o doce de leite uruguaio e o chocolate belga da banoffee e o legítimo Catupiry da torta de palmito.',
  },
];
---

<Base
  title={title}
  description={description}
  path="/sobre/"
  crumbs={crumbs}
  schema={schema}
  shareImage={fotoPreparo}
  shareImageAlt="Creme de queijo da casa sendo aplicado sobre o recheio de uma torta"
>
  <PageHero
    label="Sobre nós"
    title="De uma coisa temos certeza: sabemos fazer tortas"
    lead={`A ${business.name} é uma tortaria artesanal no ${business.address.neighborhood}, Zona Leste de São Paulo. Fazemos tortas salgadas e doces para comer na fatia, no almoço ou inteiras, por encomenda.`}
    crumbs={crumbs}
  />

  <section class="section" aria-labelledby="historia">
    <div class="container story">
      <figure class="photo story__photo">
        <Picture
          src={fotoPreparo}
          alt="Creme de queijo da casa sendo aplicado com saco de confeitar sobre o recheio de uma torta, ainda na forma"
          formats={['avif', 'webp']}
          widths={[400, 640, 944]}
          width={944}
          sizes="(max-width: 900px) calc(100vw - 40px), 480px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
      <div class="story__text">
        <span class="label">Nossa história</span>
        <h2 class="h2 story__title" id="historia">
          Uma casa de bairro que leva a torta a sério
        </h2>
        <div class="prose story__prose">
          <p>
            A {business.name} fica no {business.address.neighborhood}, na região do{' '}
            {business.address.district}, e tem um foco só: torta. Salgada ou doce, na fatia, no almoço com
            salada ou inteira, para a mesa de casa.
          </p>
          <p>
            A receita é simples de explicar:{' '}
            <strong>massa bem fininha embaixo e duas camadas de recheio em cima</strong>, feitas com
            ingredientes selecionados. Nas salgadas, o recheio ainda leva o creme de queijo da casa e vai ao
            forno para gratinar.
          </p>
          <p>O resultado é uma fatia com muito mais recheio do que massa.</p>
        </div>
        <p class="story__quote">Quem prova, pede bis.</p>
        <a class="btn btn--outline" href={href('/contato/')}>
          Venha provar: veja como chegar
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="nossa-torta">
    <div class="container">
      <header class="traits-head" data-reveal>
        <span class="label">Massa fininha, recheio em dobro</span>
        <h2 class="h2" id="nossa-torta">
          O que define a nossa torta
        </h2>
      </header>
      <ul class="traits">
        {traits.map((trait) => (
          <li class="trait" data-reveal>
            <span class="icon-dot">
              <Icon name={trait.icon} />
            </span>
            <h3 class="trait__title">{trait.title}</h3>
            <p class="trait__text">{trait.text}</p>
          </li>
        ))}
      </ul>
      <div class="traits-foot">
        <p>
          São {tortas.length} sabores: {salgadas.length} salgados e {doces.length} doces, na fatia ou
          inteiros.
        </p>
        <a class="btn btn--primary" href={href('/cardapio/')}>
          Ver o cardápio
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="reconhecimento">
    <div class="container award">
      <div class="award__seal">
        <Picture
          src={seloGuru}
          alt={`Selo “Recomendado em Restaurant Guru ${business.award.year}” concedido à ${business.name}`}
          formats={['avif', 'webp']}
          widths={[220, 362]}
          width={362}
          sizes="(max-width: 560px) 160px, 220px"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="award__text" data-reveal>
        <span class="label">Reconhecimento</span>
        <h2 class="h2 award__title" id="reconhecimento">
          {award}
        </h2>
        <p class="award__body">
          Em {business.award.year}, a {business.name} recebeu o selo de recomendação do Restaurant Guru.
        </p>
        <p class="award__body">
          Quer saber o que dizem de nós? As avaliações estão no nosso perfil do Google.
        </p>
        <a class="btn btn--outline award__cta" href={links.googleReviews} target="_blank" rel="noopener">
          <Icon name="star" />
          Ver avaliações no Google<span class="sr-only"> (abre em nova aba)</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="instagram">
    <div class="container social" data-reveal>
      <span class="icon-dot social__icon">
        <Icon name="instagram" />
      </span>
      <span class="label social__label">{business.social.instagramHandle}</span>
      <h2 class="h2 social__title" id="instagram">
        Acompanhe a casa no Instagram
      </h2>
      <p class="social__body">
        São {business.social.instagramFollowers} seguidores acompanhando as novidades da {business.name} por
        lá.
      </p>
      <div class="btn-row btn-row--center btn-row--stack-mobile social__ctas">
        <a class="btn btn--primary" href={business.social.instagram} target="_blank" rel="noopener">
          Seguir {business.social.instagramHandle}
          <span class="sr-only"> no Instagram (abre em nova aba)</span>
        </a>
        <a class="btn btn--outline" href={business.social.facebook} target="_blank" rel="noopener">
          <Icon name="facebook" />
          Facebook<span class="sr-only"> (abre em nova aba)</span>
        </a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* ---------- história ---------- */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 72px;
    align-items: center;
  }
  .story__photo {
    aspect-ratio: 4 / 5;
  }
  .story__title {
    margin-top: 12px;
  }
  .story__prose {
    margin-top: 22px;
  }
  .story__quote {
    margin: 28px 0 34px;
    padding-left: 18px;
    border-left: 2px solid var(--brand);
    font: italic 500 26px/1.25 var(--serif);
    color: var(--brand);
  }

  /* ---------- o que define a torta ---------- */
  .traits-head .h2 {
    margin-top: 12px;
  }
  .traits {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 44px;
  }
  .trait {
    padding: 28px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }
  .trait__title {
    margin-top: 20px;
    font: 600 17px/1.35 var(--sans);
  }
  .trait__text {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.65;
  }
  .traits-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    margin-top: 40px;
  }
  .traits-foot p {
    color: var(--ink-2);
  }

  /* ---------- reconhecimento ---------- */
  .award {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 64px;
    align-items: center;
    max-width: 920px;
  }
  .award__seal {
    width: 220px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: 0 24px 48px -32px rgba(43, 37, 34, 0.35);
    transform: rotate(-2deg);
  }
  .award__seal :global(img) {
    width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .award__title {
    margin-top: 12px;
  }
  .award__body {
    margin-top: 16px;
    color: var(--ink-2);
    max-width: 52ch;
  }
  .award__cta {
    margin-top: 30px;
  }

  /* ---------- instagram ---------- */
  .social {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .social__icon {
    width: 52px;
    height: 52px;
  }
  .social__icon :global(svg) {
    width: 22px;
    height: 22px;
  }
  .social__label {
    margin-top: 20px;
    letter-spacing: 0.1em;
    text-transform: none;
    font-size: 13px;
  }
  .social__title {
    margin-top: 10px;
  }
  .social__body {
    margin-top: 12px;
    color: var(--ink-2);
    max-width: 48ch;
  }
  .social__ctas {
    margin-top: 30px;
  }

  @media (max-width: 1000px) {
    .traits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .story {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
    .story__photo {
      aspect-ratio: 4 / 3;
    }
    .award {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      justify-items: start;
    }
  }
  @media (max-width: 560px) {
    .traits {
      grid-template-columns: minmax(0, 1fr);
    }
    .award__seal {
      width: 160px;
      padding: 10px;
    }
    .social__ctas {
      width: 100%;
    }
  }
</style>
