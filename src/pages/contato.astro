---
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import MapFacade from '../components/ui/MapFacade.astro';
import OpenStatus from '../components/ui/OpenStatus.astro';
import WhatsAppIcon from '../components/ui/WhatsAppIcon.astro';
import HoursTable from '../components/pages/HoursTable.astro';
import MapButtons from '../components/pages/MapButtons.astro';
import { institutionalPageSchema } from '../components/pages/page-schema';
import { business } from '../data/business';
import { href, mailUrl, telUrl, whatsappUrl } from '../lib/links';

const { address } = business;
const title = 'Contato, endereço e horários';
const description = `Endereço, horários, WhatsApp, telefone e e-mail da ${business.name}: ${address.street}, no ${address.neighborhood}, Zona Leste de São Paulo. Veja como chegar.`;
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Contato', path: '/contato/' },
];
const schema = [
  institutionalPageSchema(
    'ContactPage',
    { path: '/contato/', name: `Contato da ${business.name}`, description },
    Astro.site,
  ),
];
const cityLine = [
  `${address.neighborhood}, região do ${address.district}`,
  `${address.city} – ${address.state}`,
]
  .concat(address.postalCode ? [`CEP ${address.postalCode}`] : [])
  .join(' · ');
---

<Base title={title} description={description} path="/contato/" crumbs={crumbs} schema={schema}>
  <PageHero
    label="Contato"
    title="Como chegar e falar com a gente"
    lead={`Estamos na ${address.street}, no ${address.neighborhood}, Zona Leste de São Paulo. Pedidos e encomendas são pelo WhatsApp ${business.phone.display}.`}
    crumbs={crumbs}
  >
    <p class="hero-status">
      <OpenStatus />
    </p>
  </PageHero>

  <section class="section" aria-labelledby="endereco">
    <div class="container visit">
      <div class="visit__info">
        <span class="label">Endereço</span>
        <h2 class="h2 visit__title" id="endereco">
          {address.street}
        </h2>
        <p class="visit__city">{cityLine}</p>
        <div class="visit__buttons">
          <MapButtons where="contato" />
        </div>

        <div class="visit__hours">
          <div class="visit__hours-head">
            <h3 class="visit__subtitle">Horários</h3>
            <OpenStatus />
          </div>
          <HoursTable />
        </div>
      </div>
      <MapFacade />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="fale-conosco">
    <div class="container">
      <header class="talk-head" data-reveal>
        <span class="label">Fale com a gente</span>
        <h2 class="h2" id="fale-conosco">
          WhatsApp, telefone, e-mail e redes
        </h2>
        <p class="talk-head__sub">O jeito mais rápido de pedir ou encomendar é pelo WhatsApp.</p>
      </header>

      <ul class="channels">
        <li class="channel channel--main">
          <span class="icon-dot channel__icon channel__icon--wa">
            <WhatsAppIcon size={20} />
          </span>
          <h3 class="channel__title">WhatsApp</h3>
          <a
            class="channel__value"
            href={whatsappUrl('pedido')}
            target="_blank"
            rel="noopener"
            data-track="whatsapp"
            data-track-intent="contato-canais"
          >
            {business.phone.display}
            <span class="sr-only"> (abre em nova aba)</span>
          </a>
          <p class="channel__note">Pedidos, encomendas e dúvidas.</p>
        </li>
        <li class="channel">
          <span class="icon-dot channel__icon">
            <Icon name="phone" />
          </span>
          <h3 class="channel__title">Telefone</h3>
          <a class="channel__value" href={telUrl}>
            {business.phone.display}
          </a>
          <p class="channel__note">Se preferir ligar.</p>
        </li>
        <li class="channel">
          <span class="icon-dot channel__icon">
            <Icon name="mail" />
          </span>
          <h3 class="channel__title">E-mail</h3>
          <a class="channel__value channel__value--email" href={mailUrl}>
            {business.email}
          </a>
          <p class="channel__note">Para outros assuntos.</p>
        </li>
        <li class="channel">
          <span class="icon-dot channel__icon">
            <Icon name="instagram" />
          </span>
          <h3 class="channel__title">Instagram</h3>
          <a class="channel__value" href={business.social.instagram} target="_blank" rel="noopener">
            {business.social.instagramHandle}
            <span class="sr-only"> (abre em nova aba)</span>
          </a>
          <p class="channel__note">
            Novidades da casa. Também estamos no{' '}
            <a href={business.social.facebook} target="_blank" rel="noopener">
              Facebook<span class="sr-only"> (abre em nova aba)</span>
            </a>
            .
          </p>
        </li>
      </ul>

      <div class="btn-row btn-row--stack-mobile talk-actions">
        <a
          class="btn btn--primary"
          href={whatsappUrl('pedido')}
          target="_blank"
          rel="noopener"
          data-track="whatsapp"
          data-track-intent="contato-rodape"
        >
          <WhatsAppIcon size={18} />
          Pedir pelo WhatsApp<span class="sr-only"> (abre em nova aba)</span>
        </a>
        <a class="btn btn--outline" href={href('/encomendas/')}>
          Encomendar torta inteira
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-status {
    display: inline-flex;
    margin-top: 24px;
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    font-size: 14px;
    font-weight: 500;
  }

  /* ---------- endereço + mapa ---------- */
  .visit {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 56px;
    align-items: stretch;
  }
  .visit__title {
    margin-top: 12px;
  }
  .visit__city {
    margin-top: 10px;
    color: var(--ink-2);
  }
  .visit__buttons {
    margin-top: 28px;
  }
  .visit__hours {
    margin-top: 44px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .visit__hours-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 20px;
    margin-bottom: 16px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .visit__subtitle {
    font: 600 18px/1.3 var(--sans);
    color: var(--ink);
  }

  /* ---------- canais ---------- */
  .talk-head .h2 {
    margin-top: 12px;
  }
  .talk-head__sub {
    margin-top: 12px;
    color: var(--ink-2);
  }
  .channels {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 44px;
  }
  .channel {
    display: flex;
    flex-direction: column;
    padding: 26px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }
  .channel--main {
    border-color: var(--brand);
    box-shadow: inset 0 0 0 1px var(--brand);
  }
  .channel__icon--wa {
    background: var(--whatsapp);
    color: #fff;
  }
  .channel__title {
    margin-top: 20px;
    font: 500 11px/1.3 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .channel__value {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 2px;
    font: 600 18px/1.3 var(--sans);
    color: var(--ink);
    transition: color 0.25s var(--ease);
  }
  .channel__value:hover {
    color: var(--brand);
  }
  .channel__value--email {
    font-size: 15.5px;
    overflow-wrap: anywhere;
  }
  .channel__note {
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .channel__note a {
    color: var(--brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .talk-actions {
    margin-top: 40px;
  }

  @media (max-width: 1000px) {
    .channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .visit {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
  @media (max-width: 560px) {
    .channels {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
