---
/** "Você conhece a nossa torta?": o que torna a torta da casa diferente, em texto factual e citável. */
import { Picture } from 'astro:assets';
import Icon, { type IconName } from '../ui/Icon.astro';
import frangoCorte from '../../assets/fotos/torta-frango-corte.jpg';
import { doces, salgadas } from '../../data/menu';
import { href } from '../../lib/links';

const features: readonly { icon: IconName; text: string }[] = [
  { icon: 'slice', text: 'Massa fininha' },
  { icon: 'layers', text: 'Recheio em dobro' },
  { icon: 'cheese', text: 'Creme de queijo da casa' },
  { icon: 'list', text: `${salgadas.length} salgadas e ${doces.length} doces` },
];
---

<section class="section" aria-labelledby="torta-title">
  <div class="container about">
    <div class="photo about__photo" data-reveal>
      <Picture
        src={frangoCorte}
        alt="Fatia de torta de frango vista de lado, mostrando a massa fina na base, o recheio de frango desfiado e a camada de creme de queijo gratinada"
        formats={['avif', 'webp']}
        widths={[480, 720, 960, 1200]}
        width={1200}
        sizes="(max-width: 900px) calc(100vw - 40px), 564px"
      />
    </div>

    <div class="about__body" data-reveal>
      <span class="label">Massa fininha, recheio em dobro</span>
      <h2 class="h2 about__title" id="torta-title">
        Você conhece a nossa torta?
      </h2>
      <p class="about__text">
        Nossa torta tem massa bem fininha só na base e nas bordas. Por cima vão duas camadas generosas de
        recheio, cobertas com o creme de queijo da casa — uma receita nossa — e gratinadas no forno. O
        resultado é uma fatia com muito mais recheio do que massa.
      </p>
      <ul class="about__features">
        {features.map((f) => (
          <li class="about__feature">
            <span class="icon-dot">
              <Icon name={f.icon} />
            </span>
            {f.text}
          </li>
        ))}
      </ul>
      <a class="btn btn--outline" href={href('/cardapio/')}>
        Ver cardápio
      </a>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px;
    align-items: center;
  }
  .about__photo {
    aspect-ratio: 5 / 4;
  }
  .about__photo :global(picture) {
    height: 100%;
  }
  .about__title {
    margin-top: 12px;
  }
  .about__text {
    margin-top: 18px;
    max-width: 58ch;
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--ink-2);
  }
  .about__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 24px;
    margin: 30px 0 34px;
  }
  .about__feature {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.35;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
  @media (max-width: 380px) {
    .about__features {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
