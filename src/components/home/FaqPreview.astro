---
/**
 * Perguntas frequentes resumidas na home: 4 itens de `faq` (content.ts) em <details> nativo,
 * o primeiro aberto. Sem schema FAQPage aqui — a página /perguntas-frequentes/ já tem.
 * As perguntas são escolhidas pelo texto: se alguma mudar em content.ts, o build avisa.
 */
import Icon from '../ui/Icon.astro';
import SectionHead from '../ui/SectionHead.astro';
import { business } from '../../data/business';
import { faq, type FaqItem } from '../../data/content';
import { href } from '../../lib/links';

const HOME_QUESTIONS = [
  'Como faço um pedido?',
  'Dá para encomendar torta inteira?',
  'Tem opção vegetariana?',
  `Onde fica a ${business.name}?`,
] as const;

const items: FaqItem[] = HOME_QUESTIONS.map((question) => {
  const item = faq.find((f) => f.question === question);
  if (!item) throw new Error(`Pergunta da home não encontrada em src/data/content.ts: "${question}"`);
  return item;
});
---

<section class="section section--alt" aria-labelledby="faq-title">
  <div class="container">
    <SectionHead label="Dúvidas" title="Perguntas frequentes" id="faq-title" />

    <div class="faq" data-reveal>
      {items.map((item, i) => (
        <details class="faq__item" open={i === 0}>
          <summary class="faq__question">
            <span>{item.question}</span>
            <span class="faq__toggle" aria-hidden="true">
              <Icon name="plus" size={16} />
            </span>
          </summary>
          <p class="faq__answer">{item.answer}</p>
        </details>
      ))}
    </div>

    <div class="faq__more">
      <a class="btn btn--outline" href={href('/perguntas-frequentes/')}>
        Ver todas as perguntas
      </a>
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: 820px;
    margin: 44px auto 0;
    border-top: 1px solid var(--line);
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 44px;
    padding: 22px 4px;
    font: 600 16.5px/1.4 var(--sans);
    list-style: none;
    cursor: pointer;
    transition: color 0.25s var(--ease);
  }
  .faq__question::-webkit-details-marker {
    display: none;
  }
  .faq__question:hover {
    color: var(--brand);
  }
  .faq__toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--brand-50);
    color: var(--brand);
    transition: transform 0.3s var(--ease);
  }
  .faq__item[open] .faq__toggle {
    transform: rotate(45deg);
  }
  .faq__answer {
    padding: 0 48px 22px 4px;
    max-width: 68ch;
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--ink-2);
  }
  .faq__more {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }

  @media (max-width: 560px) {
    .faq__question {
      padding: 18px 2px;
      font-size: 16px;
    }
    .faq__answer {
      padding: 0 2px 20px;
    }
    .faq__more .btn {
      width: 100%;
    }
  }
</style>
