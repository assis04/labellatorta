---
/**
 * Bloco de compra da página do sabor: preço (ou "consulte" enquanto a casa não informar),
 * pedido e encomenda pelo WhatsApp com o sabor já na mensagem, e status discreto de aberto/fechado.
 */
import OpenStatus from '../ui/OpenStatus.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import type { Torta } from '../../data/menu';
import { formatPrice } from '../../data/menu';
import { href, whatsappOrderUrl, whatsappUrl } from '../../lib/links';
import { orderMessage } from './meta';

interface Props {
  torta: Torta;
}

const { torta } = Astro.props;
const prices = [
  { label: 'Fatia', value: formatPrice(torta.price.slice) },
  { label: 'Torta inteira', value: formatPrice(torta.price.whole) },
];
const hasAnyPrice = prices.some((p) => p.value !== null);
---

<div class="order">
  {hasAnyPrice ? (
    <dl class="order__prices">
      {prices.map((p) => (
        <div class="order__price">
          <dt class="order__key">{p.label}</dt>
          <dd class:list={['order__value', { 'order__value--ask': p.value === null }]}>
            {p.value ?? 'Consulte pelo WhatsApp'}
          </dd>
        </div>
      ))}
    </dl>
  ) : (
    <p class="order__ask">
      <span class="order__key">Fatia ou inteira</span>
      <span class="order__value order__value--ask">Consulte o preço pelo WhatsApp</span>
    </p>
  )}

  <div class="btn-row btn-row--stack-mobile order__ctas">
    <a
      class="btn btn--primary"
      href={whatsappUrl(orderMessage(torta))}
      target="_blank"
      rel="noopener"
      data-track="whatsapp"
      data-track-intent="sabor-pedido"
    >
      <WhatsAppIcon size={18} />
      Pedir pelo WhatsApp
    </a>
    <a
      class="btn btn--outline"
      href={whatsappOrderUrl(torta.name)}
      target="_blank"
      rel="noopener"
      data-track="whatsapp"
      data-track-intent="sabor-encomenda"
    >
      Encomendar inteira
    </a>
  </div>

  <div class="order__visit">
    <OpenStatus />
    <a class="order__visit-link" href={href('/contato/')}>
      Endereço e horários
    </a>
  </div>
</div>

<style>
  .order {
    margin-top: 32px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .order__prices {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
  }
  .order__ask {
    display: flex;
    flex-direction: column;
  }
  .order__key {
    display: block;
    font: 500 11px/1.3 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .order__value {
    display: block;
    margin-top: 6px;
    font: 600 30px/1.1 var(--serif);
    color: var(--brand);
  }
  .order__value--ask {
    font: 500 24px/1.2 var(--serif);
    color: var(--ink);
  }
  .order__ctas {
    margin-top: 22px;
  }
  .order__visit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 18px;
    margin-top: 14px;
    font-size: 13.5px;
    color: var(--ink-2);
  }
  .order__visit-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-color: var(--ink-2);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.25s var(--ease);
  }
  .order__visit-link:hover {
    color: var(--brand);
    text-decoration-color: currentColor;
  }
</style>
