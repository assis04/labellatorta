---
/** Cabeçalho de seção no padrão da casa: rótulo pequeno, título em serifa e subtítulo opcional. */
interface Props {
  label: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  as?: 'h1' | 'h2';
  id?: string;
}
const { label, title, subtitle, align = 'center', as: Tag = 'h2', id } = Astro.props;
---

<header class:list={['section-head', `section-head--${align}`]} data-reveal>
  <span class="label">{label}</span>
  <Tag class:list={[Tag === 'h1' ? 'h1' : 'h2', 'section-head__title']} id={id}>
    {title}
  </Tag>
  {subtitle && <p class="section-head__sub">{subtitle}</p>}
  <slot />
</header>

<style>
  .section-head__title {
    margin-top: 12px;
  }
  .section-head__sub {
    margin-top: 12px;
    color: var(--ink-2);
    font-size: 16px;
  }
  .section-head--center {
    text-align: center;
    max-width: 680px;
    margin-inline: auto;
  }
</style>
