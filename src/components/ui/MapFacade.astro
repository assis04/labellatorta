---
/**
 * Mapa com carregamento sob demanda: a página abre leve (sem os ~600 KB do Google Maps) e o
 * iframe só é criado quando a pessoa clica. Sem JS, o botão vira link para o Google Maps.
 * O domínio do iframe está liberado na CSP (frame-src https://www.google.com).
 */
import Icon from './Icon.astro';
import { business, links, fullAddress } from '../../data/business';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const title = `Mapa com a localização da ${business.name}`;
---

<div
  class:list={['map-facade', className]}
  data-map-facade
  data-src={links.googleMapsEmbed}
  data-title={title}
>
  <svg class="map-facade__art" viewBox="0 0 600 440" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g fill="none" stroke="#fff" stroke-linecap="round">
      <path d="M-20 110 L640 70" stroke-width="16"></path>
      <path d="M-20 330 L640 300" stroke-width="22"></path>
      <path d="M130 -20 L170 470" stroke-width="10"></path>
      <path d="M300 -20 L300 470" stroke-width="12"></path>
      <path d="M470 -20 L430 470" stroke-width="10"></path>
      <path d="M-20 215 L640 200" stroke-width="8"></path>
      <path d="M40 -20 C 120 160, 60 300, 220 470" stroke-width="6"></path>
      <path d="M560 -20 C 520 120, 600 260, 520 470" stroke-width="6"></path>
      <path d="M210 -20 L230 470" stroke-width="5"></path>
      <path d="M380 -20 L370 470" stroke-width="5"></path>
    </g>
    <rect x="40" y="140" width="70" height="50" rx="8" fill="#dce7d2"></rect>
    <rect x="480" y="230" width="90" height="56" rx="8" fill="#dce7d2"></rect>
  </svg>

  <div class="map-facade__pin" aria-hidden="true">
    <span class="map-facade__pin-label">{business.name}</span>
    <svg viewBox="0 0 24 24" width="34" height="34">
      <path
        d="M12 22s-7.5-6.4-7.5-12.2A7.5 7.5 0 0 1 19.5 9.8C19.5 15.6 12 22 12 22Z"
        fill="currentColor"
      ></path>
      <circle cx="12" cy="9.8" r="2.6" fill="#fff"></circle>
    </svg>
  </div>

  <div class="map-facade__bar">
    <p class="map-facade__addr">{fullAddress}</p>
    <div class="map-facade__actions">
      <button type="button" class="btn btn--sm btn--primary" data-map-load hidden>
        <Icon name="pin" />
        Carregar mapa
      </button>
      <a
        class="btn btn--sm btn--outline"
        href={links.googleMaps}
        target="_blank"
        rel="noopener"
        data-track="mapa"
        data-track-intent="google-maps"
      >
        Abrir no Google Maps
      </a>
    </div>
    <p class="map-facade__note">Ao carregar o mapa, o Google pode coletar dados de navegação.</p>
  </div>
</div>

<script>
  import '../../scripts/map-facade';
</script>

<style>
  .map-facade {
    position: relative;
    min-height: 440px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: #ede5d8;
  }
  .map-facade__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .map-facade__pin {
    position: absolute;
    left: 50%;
    top: 42%;
    transform: translate(-50%, -100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: var(--brand);
  }
  .map-facade__pin-label {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    font: 600 13px/1.2 var(--sans);
    color: var(--ink);
    white-space: nowrap;
    box-shadow: 0 8px 20px -10px rgba(43, 37, 34, 0.35);
  }
  .map-facade__bar {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    display: grid;
    gap: 10px;
    padding: 14px 16px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .map-facade__addr {
    font-size: 14px;
    font-weight: 500;
  }
  .map-facade__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .map-facade__note {
    font-size: 12px;
    color: var(--ink-3);
  }
  .map-facade :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @media (max-width: 900px) {
    .map-facade {
      min-height: 380px;
    }
  }
</style>
