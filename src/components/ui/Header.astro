---
/**
 * Cabeçalho fixo. Na home (overlay) começa transparente sobre a foto e fica sólido ao rolar;
 * nas internas já nasce sólido. Menu móvel em tela cheia, acessível por teclado (Esc fecha).
 */
import Icon from './Icon.astro';
import { mainNav } from '../../data/content';
import { business } from '../../data/business';
import { href, whatsappUrl } from '../../lib/links';

interface Props {
  overlay?: boolean;
  currentPath: string;
}
const { overlay = false, currentPath } = Astro.props;
const isCurrent = (path: string) => currentPath === path || (path !== '/' && currentPath.startsWith(path));
const homeLabel = `${business.name} — página inicial`;
---

<header
  class:list={['site-header', { 'is-overlay': overlay, 'is-solid': !overlay }]}
  data-header
  data-overlay={overlay ? 'true' : undefined}
>
  <div class="container site-header__inner">
    <a href={href('/')} class="logo" aria-label={homeLabel}>
      <span class="logo__name">{business.name}</span>
      <span class="logo__tag">{business.tagline}</span>
    </a>

    <nav class="site-nav" aria-label="Principal">
      <ul>
        {mainNav.map((item) => (
          <li>
            <a href={href(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__ctas">
      <a href={href('/encomendas/')} class="btn btn--sm btn--outline site-header__secondary">
        Encomendar
      </a>
      <a
        href={whatsappUrl('pedido')}
        class="btn btn--sm btn--primary"
        target="_blank"
        rel="noopener"
        data-track="whatsapp"
        data-track-intent="header"
      >
        Pedir agora
      </a>
    </div>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-open
    >
      <Icon name="menu" size={24} />
      <span class="sr-only">Abrir menu</span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" data-menu hidden>
  <div class="mobile-menu__top">
    <span class="logo">
      <span class="logo__name">{business.name}</span>
      <span class="logo__tag">{business.tagline}</span>
    </span>
    <button class="menu-toggle menu-toggle--close" type="button" data-menu-close>
      <Icon name="close" size={26} />
      <span class="sr-only">Fechar menu</span>
    </button>
  </div>
  <nav aria-label="Menu móvel">
    <ul>
      {[{ label: 'Início', path: '/' }, ...mainNav].map((item) => (
        <li>
          <a href={href(item.path)} aria-current={currentPath === item.path ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <a
    href={whatsappUrl('pedido')}
    class="btn btn--primary btn--block"
    target="_blank"
    rel="noopener"
    data-track="whatsapp"
    data-track-intent="menu"
  >
    Pedir pelo WhatsApp
  </a>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: var(--header-h);
    color: var(--ink);
    transition:
      background-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .logo {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo__name {
    font: 600 italic 27px/1 var(--serif);
    letter-spacing: -0.01em;
  }
  .logo__tag {
    font: 500 9px/1 var(--sans);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-top: 6px;
    opacity: 0.85;
  }
  .site-nav ul {
    display: flex;
    gap: 30px;
  }
  .site-nav a {
    display: block;
    font: 500 14px/1 var(--sans);
    padding-block: 8px;
    border-bottom: 1px solid transparent;
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .site-nav a:hover {
    color: var(--brand);
  }
  .site-nav a[aria-current='page'] {
    border-bottom-color: currentColor;
  }
  .site-header__ctas {
    display: flex;
    gap: 10px;
  }
  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: none;
    place-items: center;
    color: inherit;
  }

  .site-header.is-solid {
    background: rgba(250, 247, 242, 0.96);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow:
      0 1px 0 var(--line),
      0 6px 20px -14px rgba(43, 37, 34, 0.25);
  }
  .site-header.is-overlay:not(.is-solid) {
    color: #fff;
  }
  .site-header.is-overlay:not(.is-solid) .site-nav a:hover {
    color: var(--gold);
  }
  .site-header.is-overlay:not(.is-solid) .site-header__secondary {
    border-color: rgba(255, 255, 255, 0.75);
    color: #fff;
  }
  .site-header.is-overlay:not(.is-solid) .site-header__secondary:hover {
    background: #fff;
    color: var(--ink);
  }

  @media (max-width: 1000px) {
    .site-nav,
    .site-header__secondary {
      display: none;
    }
    .menu-toggle {
      display: grid;
    }
  }
  @media (max-width: 640px) {
    .site-header__ctas {
      display: none;
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    background: var(--bg);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    padding: 12px 20px 28px;
    overflow-y: auto;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    margin-top: 8px;
  }
  .mobile-menu nav {
    margin-top: 28px;
  }
  .mobile-menu nav a {
    display: block;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font: 500 30px/1.2 var(--serif);
  }
  .mobile-menu nav a[aria-current='page'] {
    color: var(--brand);
  }
  .mobile-menu > .btn {
    margin-top: auto;
  }
  .menu-toggle--close {
    display: grid;
  }
</style>
