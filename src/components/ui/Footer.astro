---
import Icon from './Icon.astro';
import { business, openingHours, fullAddress } from '../../data/business';
import { footerNav } from '../../data/content';
import { href, mailUrl, whatsappUrl } from '../../lib/links';
import { hoursTable } from '../../lib/hours';

const rows = hoursTable(openingHours);
const year = new Date().getFullYear();
const instagramLabel = `Instagram da ${business.name}`;
const facebookLabel = `Facebook da ${business.name}`;
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <a href={href('/')} class="site-footer__logo">
          <span class="site-footer__name">{business.name}</span>
          <span class="site-footer__tag">{business.tagline}</span>
        </a>
        <p class="site-footer__about">
          Tortas salgadas e doces com massa fininha e recheio em dobro, no {business.address.neighborhood},
          Zona Leste de São Paulo.
        </p>
      </div>
      <nav aria-label="Rodapé">
        <h2 class="site-footer__title">Links</h2>
        <ul>
          {footerNav.map((item) => (
            <li>
              <a href={href(item.path)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <div>
        <h2 class="site-footer__title">Contato</h2>
        <address>
          <ul>
            <li>{fullAddress}</li>
            <li>
              <a
                href={whatsappUrl('pedido')}
                target="_blank"
                rel="noopener"
                data-track="whatsapp"
                data-track-intent="footer"
              >
                WhatsApp {business.phone.display}
              </a>
            </li>
            <li>
              <a href={mailUrl}>{business.email}</a>
            </li>
          </ul>
        </address>
      </div>
      <div>
        <h2 class="site-footer__title">Horários</h2>
        <ul>
          {rows.map((r) => (
            <li>
              {r.label} · {r.value}
            </li>
          ))}
        </ul>
        <h2 class="site-footer__title site-footer__title--spaced">Redes sociais</h2>
        <div class="site-footer__social">
          <a href={business.social.instagram} target="_blank" rel="noopener" aria-label={instagramLabel}>
            <Icon name="instagram" />
          </a>
          <a href={business.social.facebook} target="_blank" rel="noopener" aria-label={facebookLabel}>
            <Icon name="facebook" />
          </a>
        </div>
      </div>
    </div>
    <p class="site-footer__base">
      © {year} {business.name}. Todos os direitos reservados.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--footer);
    color: rgba(255, 255, 255, 0.72);
    padding: 72px 0 32px;
    font-size: 14px;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr 1fr;
    gap: 40px;
  }
  .site-footer__logo {
    display: inline-flex;
    flex-direction: column;
    color: #fff;
    line-height: 1;
  }
  .site-footer__name {
    font: 600 italic 27px/1 var(--serif);
  }
  .site-footer__tag {
    font: 500 9px/1 var(--sans);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-top: 6px;
    opacity: 0.85;
  }
  .site-footer__about {
    margin-top: 18px;
    max-width: 34ch;
    line-height: 1.7;
  }
  .site-footer__title {
    margin-bottom: 14px;
    font: 500 11px/1.3 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .site-footer__title--spaced {
    margin-top: 28px;
  }
  .site-footer li + li {
    margin-top: 9px;
  }
  .site-footer address {
    font-style: normal;
  }
  .site-footer a:hover {
    color: #fff;
  }
  .site-footer__social {
    display: flex;
    gap: 12px;
  }
  .site-footer__social a {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.22);
    display: grid;
    place-items: center;
    transition: border-color 0.25s var(--ease);
  }
  .site-footer__social a:hover {
    border-color: #fff;
  }
  .site-footer__base {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.6);
  }
  @media (max-width: 900px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
