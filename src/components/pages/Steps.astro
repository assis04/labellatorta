---
/** Passo a passo numerado (lista ordenada de verdade), em coluna ou em linha. */
interface Props {
  steps: readonly { title: string; text: string }[];
  layout?: 'stack' | 'row';
  /** Nível do título de cada passo, para manter a hierarquia da página. */
  headingLevel?: 'h3' | 'h4';
  class?: string;
}
const { steps, layout = 'stack', headingLevel: Heading = 'h3', class: className } = Astro.props;
---

<ol class:list={['steps', `steps--${layout}`, className]}>
  {steps.map((step, i) => (
    <li class="steps__item">
      <span class="steps__n" aria-hidden="true">
        {i + 1}
      </span>
      <div>
        <Heading class="steps__title">{step.title}</Heading>
        <p class="steps__text">{step.text}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .steps {
    display: grid;
    gap: 22px;
  }
  .steps__item {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }
  .steps__n {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--brand);
    color: var(--brand);
    display: grid;
    place-items: center;
    font: 600 15px/1 var(--sans);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .steps__title {
    font: 600 17px/1.35 var(--sans);
    margin-top: 8px;
  }
  .steps__text {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.7;
  }
  .steps--row {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .steps--row .steps__item {
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .steps--row .steps__title {
    margin-top: 0;
  }
  @media (max-width: 860px) {
    .steps--row {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }
    .steps--row .steps__item {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 16px;
      padding-top: 22px;
    }
    .steps--row .steps__title {
      margin-top: 8px;
    }
  }
</style>
