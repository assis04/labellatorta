# Origem pública do site (canonical, sitemap, Open Graph).
SITE_URL=https://www.labellatorta.com.br
# Subcaminho do site. "/" no domínio próprio; "/<repo>/" em <usuario>.github.io/<repo>/.
BASE_PATH=/
# "false" em prévias (ex.: GitHub Pages antes do domínio próprio) para não indexar no Google.
SITE_INDEXABLE=true
# Opcional: domínio cadastrado no Plausible para analytics sem cookies (vazio = desligado).
PLAUSIBLE_DOMAIN=
